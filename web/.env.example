# Chaves e cotas do servidor do Simetrics.
#
# Copie para `web/.env` (já ignorado pelo git) no desenvolvimento; em produção, cadastre as
# mesmas variáveis no painel da Netlify (Site configuration → Environment variables) ou
# importe este arquivo com `npx netlify-cli env:import .env`.
#
# Nenhuma delas tem o prefixo VITE_: são lidas só no servidor (server/handlers.ts, pela
# Netlify Function `api` em produção e pelo plugin do Vite no desenvolvimento) e nunca
# chegam ao navegador.

# DeepSeek — Simi gratuita, descoberta de categorias gratuita e nome dos temas do k-means
# para quem não tem chave própria.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Jev (TypeSafe) — classificação híbrida, livre para os usuários. A API do Jev recusa
# chamadas diretas do navegador, por isso ela sempre passa pelo servidor.
TYPESAFE_API_KEY=

# Cotas gratuitas por dispositivo (0 desativa).
# SIMI_FREE_QUESTIONS=10
# HYBRID_FREE_RUNS=3

# Tetos diários por IP, contra quem apaga o armazenamento do navegador para zerar a cota.
# Largos o bastante para laboratórios e universidades que saem pelo mesmo IP.
# SIMI_IP_DAILY_LIMIT=100
# HYBRID_IP_DAILY_LIMIT=20
# LABEL_IP_DAILY_LIMIT=400

# Sal dos hashes de dispositivo e IP guardados nas cotas. Defina um valor aleatório em
# produção; trocá-lo zera todas as cotas.
# QUOTA_SALT=
