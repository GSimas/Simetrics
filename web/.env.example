# Chave da API do Google Gemini.
#
# Usada EXCLUSIVAMENTE pelas Netlify Functions (server-side). Nunca prefixe com VITE_,
# ou a chave vai parar no bundle do cliente.
GEMINI_API_KEY=

# Modelos, opcionais. Ficam em variáveis porque os identificadores do Gemini são
# descontinuados periodicamente — quando um sair do ar, trocar aqui evita novo deploy.
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_LABEL_MODEL=gemini-2.5-flash-lite

# Chave do Jev (TypeSafe), opcional — usada pela classificação híbrida quando o usuário
# não informa a própria chave na interface. Lida só no servidor: pela Netlify Function
# jev-systemone em produção e pelo proxy do Vite (vite.config.ts) no desenvolvimento.
# A API do Jev recusa chamadas diretas do navegador, por isso sempre há um proxy no meio.
# TYPESAFE_API_KEY=
